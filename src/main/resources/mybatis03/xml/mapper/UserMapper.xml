<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mybatis03.xml.UserMapper">

    <resultMap id="userResultMap" type="com.mybatis03.entity.User">
        <id     property="id"          column="id"/>
        <result property="username"    column="username"/>
        <result property="password"    column="password"/>
        <result property="email"       column="email"/>
        <result property="createTime"  column="create_time"/>
        <result property="updateTime"  column="update_time"/>
    </resultMap>

    <select id="findUsersByCondition" parameterType="com.mybatis03.entity.User"
            resultMap="userResultMap">
        SELECT * FROM user
        <where>
            <if test="username != null and username != ''">
                AND username LIKE CONCAT('%', #{username}, '%')
            </if>
            <if test="email != null and email != ''">
                AND email = #{email}
            </if>
            <if test="id != null">
                AND id = #{id}
            </if>
        </where>
    </select>

    <update id="updateUserSelective" parameterType="com.mybatis03.entity.User">
        UPDATE user
        <set>
            <if test="username != null">username = #{username},</if>
            <if test="password != null">password = #{password},</if>
            <if test="email != null">email = #{email},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        WHERE id = #{id}
    </update>

    <select id="findUserPriority" parameterType="com.mybatis03.entity.User"
            resultMap="userResultMap">
        SELECT * FROM user
        <where>
            <choose>
                <when test="id != null">
                    id = #{id}
                </when>
                <when test="username != null and username != ''">
                    username LIKE CONCAT('%', #{username}, '%')
                </when>
                <when test="email != null and email != ''">
                    email = #{email}
                </when>
                <otherwise>
                    1 = 1
                </otherwise>
            </choose>
        </where>
    </select>

    <select id="findByIds" resultMap="userResultMap">
        SELECT * FROM user
        WHERE id IN
        <foreach collection="ids" item="id"
                 open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO user(username, password, email, create_time, update_time)
        VALUES
        <foreach collection="list" item="u" separator=",">
            (#{u.username}, #{u.password}, #{u.email}, IFNULL(#{u.createTime}, NOW()), IFNULL(#{u.updateTime}, NOW()))
        </foreach>
    </insert>

    <select id="findUsersByTrim" parameterType="com.mybatis03.entity.User"
            resultMap="userResultMap">
        SELECT * FROM user
        <trim prefix="WHERE" prefixOverrides="AND |OR ">
            <if test="username != null and username != ''">
                AND username LIKE CONCAT('%', #{username}, '%')
            </if>
            <if test="email != null and email != ''">
                AND email = #{email}
            </if>
        </trim>
    </select>

    <sql id="userColumns">
        id, username, password, email, create_time, update_time
    </sql>

    <sql id="commonWhereCondition">
        <if test="username != null and username != ''">
            AND username LIKE CONCAT('%', #{username}, '%')
        </if>
        <if test="email != null and email != ''">
            AND email = #{email}
        </if>
    </sql>

    <select id="findUsersWithInclude" parameterType="com.mybatis03.entity.User"
            resultMap="userResultMap">
        SELECT <include refid="userColumns"/> FROM user
        <where>
            <include refid="commonWhereCondition"/>
        </where>
    </select>

    <!--
      <bind> 标签：用 OGNL 表达式把计算结果绑定到新变量
      =====================================================
      name  → 绑定的变量名（SQL 中用 #{变量名} 取值）
      value → OGNL 表达式（字符串拼接：'%' + keyword + '%'）
      好处：模糊查询的 % 拼接从 Java 层移到 XML；结果仍走 #{} 预编译，无注入风险
    -->
    <select id="findUserByBind" parameterType="string" resultMap="userResultMap">
        <bind name="keywordLike" value="'%' + keyword + '%'"/>
        SELECT * FROM user WHERE username LIKE #{keywordLike}
    </select>

</mapper>