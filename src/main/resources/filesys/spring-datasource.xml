<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:tx="http://www.springframework.org/schema/tx"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context.xsd
           http://www.springframework.org/schema/tx
           http://www.springframework.org/schema/tx/spring-tx.xsd">

    <!--
      资料上传下载系统 —— 数据层（Spring 整合 MyBatis）
      =====================================================
      由 FileSysMvcConfig 通过 @ImportResource 引入。

      【Bean 命名】本模块的 DispatcherServlet 子容器以 ssm 的根容器为父容器，
      父容器里已有 dataSource / sqlSessionFactory / transactionManager。
      这里统一加 filesys 前缀，并在 MapperScanner、tx:annotation-driven 中按名字引用，
      避免按类型注入时找到两个候选 Bean。
    -->
    <context:property-placeholder
            location="classpath:common/db.properties,classpath:filesys/filesys.properties"/>

    <bean id="filesysDataSource" class="com.zaxxer.hikari.HikariDataSource" destroy-method="close">
        <property name="driverClassName" value="${jdbc.driver}"/>
        <property name="jdbcUrl" value="${jdbc.url}"/>
        <property name="username" value="${jdbc.username}"/>
        <property name="password" value="${jdbc.password}"/>
        <property name="maximumPoolSize" value="5"/>
    </bean>

    <!-- SQL 全部写在 mapper XML 中（任务书要求：MyBatis + XML 映射） -->
    <bean id="filesysSqlSessionFactory" class="org.mybatis.spring.SqlSessionFactoryBean">
        <property name="dataSource" ref="filesysDataSource"/>
        <property name="mapperLocations" value="classpath:filesys/mapper/*.xml"/>
        <property name="configuration">
            <bean class="org.apache.ibatis.session.Configuration">
                <!-- origin_name → originName -->
                <property name="mapUnderscoreToCamelCase" value="true"/>
            </bean>
        </property>
    </bean>

    <bean class="org.mybatis.spring.mapper.MapperScannerConfigurer">
        <property name="basePackage" value="com.filesys.mapper"/>
        <property name="sqlSessionFactoryBeanName" value="filesysSqlSessionFactory"/>
    </bean>

    <bean id="filesysTxManager" class="org.springframework.jdbc.datasource.DataSourceTransactionManager">
        <property name="dataSource" ref="filesysDataSource"/>
    </bean>
    <tx:annotation-driven transaction-manager="filesysTxManager"/>
</beans>
