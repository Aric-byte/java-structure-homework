<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/mvc
           http://www.springframework.org/schema/mvc/spring-mvc.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context.xsd">

    <!--
      SpringMVC 注解方式配置
      =====================================================
      ① <mvc:annotation-driven>：开启注解驱动
         - 注册 RequestMappingHandlerMapping（处理 @RequestMapping）
         - 注册 RequestMappingHandlerAdapter（参数绑定、@ResponseBody 转 JSON 等）
      ② <context:component-scan>：扫描 @RestController 所在包
    -->
    <!--
      【@ResponseBody/@RestController 中文乱码】
      StringHttpMessageConverter 默认 charset=ISO-8859-1，
      CharacterEncodingFilter 管不到它（转换器自己编码写出字节）→ 中文变 ?
      解决：在 annotation-driven 里注册 UTF-8 的 StringHttpMessageConverter
    -->
    <mvc:annotation-driven>
        <mvc:message-converters>
            <bean class="org.springframework.http.converter.StringHttpMessageConverter">
                <property name="supportedMediaTypes">
                    <list>
                        <value>text/plain;charset=UTF-8</value>
                        <value>text/html;charset=UTF-8</value>
                        <value>application/json;charset=UTF-8</value>
                    </list>
                </property>
            </bean>
        </mvc:message-converters>
    </mvc:annotation-driven>

    <context:component-scan base-package="com.springmvc.controller"/>
    <!-- 全局异常处理类：@ControllerAdvice 也要被扫描到才生效 -->
    <context:component-scan base-package="com.springmvc.exception"/>

    <!--
      静态资源访问 —— <mvc:resources>
      =====================================================
      DispatcherServlet 若映射了 /（本项目是 /annotation/*，影响不到静态资源，
      但生产项目通常映射 /，必须配这个，否则 css/js/图片 404）
      mapping → URL 虚拟路径；location → 实际位置（webapp 根/磁盘目录均可）
    -->
    <mvc:resources mapping="/static/**" location="/static/"/>

    <!--
      拦截器注册 —— <mvc:interceptors>
      =====================================================
      ① <mvc:mapping>         → 拦截哪些路径（Ant 风格 /**）
      ② <mvc:exclude-mapping> → 排除哪些路径
      ③ <bean>                → 拦截器实现类
      ④ 多个拦截器【按声明顺序执行】preHandle，postHandle/afterCompletion 逆序
    -->
    <mvc:interceptors>

        <!-- 拦截器①：耗时统计 —— 拦截 /page/** 下所有页面跳转（放行演示） -->
        <mvc:interceptor>
            <mvc:mapping path="/page/**"/>
            <bean class="com.springmvc.interceptor.TimeInterceptor"/>
        </mvc:interceptor>

        <!-- 拦截器②：登录检查 —— 只拦 /student/**，
             preHandle 返回 false 中断请求（未登录重定向到 /annotation/page/session） -->
        <mvc:interceptor>
            <mvc:mapping path="/student/**"/>
            <bean class="com.springmvc.interceptor.LoginInterceptor"/>
        </mvc:interceptor>

    </mvc:interceptors>

    <!--
      文件上传 —— MultipartResolver
      =====================================================
      ① Bean 名【必须】叫 multipartResolver（DispatcherServlet 按这个名字查找）
      ② defaultEncoding   → 解决上传中文文件名乱码
      ③ maxUploadSize      → 单次请求最大 10MB（超出抛 MaxUploadSizeExceededException）
      ④ maxInMemorySize    → 超过 1MB 的文件写临时目录，不占内存
    -->
    <bean id="multipartResolver"
          class="org.springframework.web.multipart.commons.CommonsMultipartResolver">
        <property name="defaultEncoding" value="UTF-8"/>
        <property name="maxUploadSize" value="10485760"/>
        <property name="maxInMemorySize" value="1048576"/>
    </bean>

    <!-- 视图解析器：@Controller 返回的逻辑视图名 → JSP 路径
         page/show → /WEB-INF/views/page/show.jsp（与 XML 方式配置原理相同） -->
    <bean class="org.springframework.web.servlet.view.InternalResourceViewResolver">
        <property name="prefix" value="/WEB-INF/views/"/>
        <property name="suffix" value=".jsp"/>
    </bean>

</beans>
