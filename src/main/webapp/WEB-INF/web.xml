<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!--
      ============================================================
      SSM 整合 —— 父容器监听器（Service/Mapper/事务）
      ============================================================
      ContextLoaderListener 启动时加载 applicationContext.xml（全局唯一），
      之后所有 DispatcherServlet 的子容器都以它为父容器
    -->
    <context-param>
        <param-name>contextConfigLocation</param-name>
        <param-value>classpath:ssm/applicationContext.xml</param-value>
    </context-param>
    <listener>
        <listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>
    </listener>

    <!--
      ============================================================
      POST 中文乱码 —— CharacterEncodingFilter（必须放在最前面）
      ============================================================
      GET 请求乱码由 Tomcat（server.xml URIEncoding）处理；
      POST 请求体由本过滤器统一转 UTF-8，forceEncoding 连响应也强制
      缺了它：POST 表单/上传接口里的中文参数会变成 ???
    -->
    <filter>
        <filter-name>encodingFilter</filter-name>
        <filter-class>org.springframework.web.filter.CharacterEncodingFilter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
        <init-param>
            <param-name>forceEncoding</param-name>
            <param-value>true</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>encodingFilter</filter-name>
        <url-pattern>/annotation/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>encodingFilter</filter-name>
        <url-pattern>/ssm/*</url-pattern>
    </filter-mapping>

    <!--
      ============================================================
      SpringMVC 注解方式（@RestController + mvc:annotation-driven）
      访问示例：
        /annotation/student/hello
        /annotation/student/list?major=CS
        /annotation/student/detail/1
      ============================================================
    -->
    <servlet>
        <servlet-name>springmvc-annotation</servlet-name>
        <servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
        <init-param>
            <param-name>contextConfigLocation</param-name>
            <param-value>classpath:springmvc/annotation/springmvc-servlet.xml</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>springmvc-annotation</servlet-name>
        <url-pattern>/annotation/*</url-pattern>
    </servlet-mapping>

    <!--
      ============================================================
      SpringMVC XML 方式（Controller 接口 + BeanNameUrlHandlerMapping）
      访问示例：
        /xml/student/list → JSP 视图渲染
      ============================================================
    -->
    <servlet>
        <servlet-name>springmvc-xml</servlet-name>
        <servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
        <init-param>
            <param-name>contextConfigLocation</param-name>
            <param-value>classpath:springmvc/xml/springmvc-servlet.xml</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>springmvc-xml</servlet-name>
        <url-pattern>/xml/*</url-pattern>
    </servlet-mapping>

    <!--
      ============================================================
      SSM 整合 —— 子容器（Controller 层）
      访问示例：
        /ssm/student/list          → 列表页（DB 真实数据）
        /ssm/student/add (POST)    → 新增（事务）
        /ssm/student/add-fail      → 事务回滚演示
        /ssm/student/delete/3      → 删除（事务）
      ============================================================
    -->
    <servlet>
        <servlet-name>ssm</servlet-name>
        <servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
        <init-param>
            <param-name>contextConfigLocation</param-name>
            <param-value>classpath:ssm/spring-mvc.xml</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>ssm</servlet-name>
        <url-pattern>/ssm/*</url-pattern>
    </servlet-mapping>

</web-app>
